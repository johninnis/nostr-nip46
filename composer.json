{
    "name": "innis/nostr-nip46",
    "description": "NIP-46 (Nostr Connect / bunker) remote-signer protocol for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nostr",
        "protocol",
        "nip-46",
        "nostr-connect",
        "bunker",
        "remote-signer"
    ],
    "authors": [
        {
            "name": "John Innis",
            "email": "john@innis.xyz",
            "homepage": "https://www.innis.xyz/"
        }
    ],
    "require": {
        "php": "^8.4",
        "innis/nostr-core": "^0.6"
    },
    "require-dev": {
        "ext-ffi": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "innis/coding-standards": "^0.1",
        "phpstan/phpstan": "~2.2.6",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.1",
        "rector/rector": "~2.5.9"
    },
    "autoload": {
        "psr-4": {
            "Innis\\Nostr\\Nip46\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innis\\Nostr\\Nip46\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "@analyse"
        ],
        "test-unit": "phpunit --testsuite=Unit",
        "test-integration": "phpunit --testsuite=Integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/tests/coverage/html --coverage-text --coverage-clover var/tests/coverage/clover.xml",
        "analyse": "phpstan analyse",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "check-rector": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
